# InsForge project (npx @insforge/cli secrets get ANON_KEY; URL from .insforge/project.json)
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only. Fetch with: npx @insforge/cli ai setup
OPENROUTER_API_KEY=
# Optional override (default: google/gemini-2.5-flash)
OPENROUTER_CHAT_MODEL=

# Public origin, used for OAuth redirects and OG metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000
