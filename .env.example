# InsForge project (npx @insforge/cli secrets get ANON_KEY; URL from .insforge/project.json)
NEXT_PUBLIC_INSFORGE_URL=https://your-appkey.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Server-only. Fetch with: npx @insforge/cli ai setup
OPENROUTER_API_KEY=
# Optional override (default: google/gemini-2.5-flash)
OPENROUTER_CHAT_MODEL=

# Public origin, used for OAuth redirects and OG metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Care Plan (server-only unless NEXT_PUBLIC) ----
# 32-byte base64 AES-256-GCM key for health-field encryption: openssl rand -base64 32
# Back it up in a password manager. Losing it makes stored health data unreadable.
HEALTH_DATA_KEY=
# Project admin key (npx @insforge/cli, .insforge/project.json). Used ONLY by the reminder dispatcher.
INSFORGE_API_KEY=
# Shared secret for the reminder cron: openssl rand -hex 24
CRON_SECRET=
# Web push keys: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---- Billing (Stripe via InsForge Payments) ----
# "test" until live keys are configured and approved.
NEXT_PUBLIC_PAYMENTS_ENV=test
# Optional overrides for live price ids (defaults are the test catalog in lib/billing.ts)
NEXT_PUBLIC_PRICE_INR_MONTH=
NEXT_PUBLIC_PRICE_INR_YEAR=
NEXT_PUBLIC_PRICE_USD_MONTH=
NEXT_PUBLIC_PRICE_USD_YEAR=
